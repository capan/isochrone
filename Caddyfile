# Set SITE_ADDRESS to your hostname (e.g. iso.example.com) and Caddy fetches
# a Let's Encrypt certificate automatically. Defaults to :80 for local testing.
{$SITE_ADDRESS::80} {
	encode zstd gzip
	reverse_proxy app:3001
}

# This Caddy owns 80/443 on the box, so sibling services (eudr, cbam) front
# through it rather than shipping a second one: each joins `isochrone_default`
# as an external network, and each ships its OWN site block into the sites dir
# from its OWN repo -- so adding a service never edits this file. An empty
# sites dir is a valid config, which is what local dev sees.
import /etc/caddy/sites/*.caddy
