<?xml version="1.0" encoding="UTF-8"?>
<!-- a way is imported if it matches one of the following tag_values -->
<!-- tag_values are processed in the order of their ID -->
<configuration>
  <tag_name name="highway" id="1">
    <tag_value name="footway" id="101" />
    <tag_value name="pedestrian" id="102" />
    <tag_value name="path" id="103" />
    <tag_value name="steps" id="104" />
    <tag_value name="living_street" id="105" />
    <tag_value name="residential" id="106" />
    <tag_value name="track" id="107" />
    <tag_value name="unclassified" id="108" />
    <!-- Kreis-/Landesstraßen. Excluded originally because city arterials have
         separately mapped sidewalks, but rural villages are often linked only
         by these — without them a 5x5km rural import is disconnected islands
         and clicks land >500m from any way. Ids 109/110 are new, so the
         103/104/105/107 that PROFILES depends on are untouched. -->
    <tag_value name="tertiary" id="109" />
    <tag_value name="tertiary_link" id="110" />
    <tag_value name="secondary" id="111" />
    <tag_value name="secondary_link" id="112" />
    <!-- Dedicated cycle paths. Bike-only: the `bike` profile rides them at
         full speed, the three pedestrian profiles treat them as impassable,
         so adding this does not change any walking result. -->
    <tag_value name="cycleway" id="113" />
  </tag_name>

  <tag_name name="cycleway" id="2">
    <tag_value name="lane" id="201" />
    <tag_value name="track" id="202" />
    <tag_value name="opposite_lane" id="203" />
    <tag_value name="opposite" id="204" />
  </tag_name>

  <tag_name name="tracktype" id="3">
    <tag_value name="grade1" id="301" />
    <tag_value name="grade2" id="302" />
    <tag_value name="grade3" id="303" />
    <tag_value name="grade4" id="304" />
    <tag_value name="grade5" id="305" />
  </tag_name>

  <tag_name name="foot" id="4">
    <tag_value name="yes" id="401" />
    <tag_value name="designated" id="402" />
    <tag_value name="permissive" id="403" />
  </tag_name>
</configuration>