# Copy to .env and change the password before exposing anything publicly.
PGPASSWORD=password

# Which city schema the backend queries — must match the schema
# import_city.sh created (dashes become underscores: greater_london).
CITY=berlin

# Hostname Caddy serves and fetches a TLS certificate for.
# Leave as :80 for local testing; set to a real hostname to get HTTPS.
SITE_ADDRESS=:80

# Host directory holding the personal site's built files, mounted read-only at
# /srv/site so this stack's Caddy can serve them; the site's own repo fills it.
SITE_ROOT_DIR=/opt/site

# Host directory Caddy writes its access logs into, mounted read-write at
# /var/log/caddy so the logs outlive the container and can be read over SSH.
CADDY_LOGS_DIR=/opt/caddy-logs

# Longest isochrone accepted, and per-IP requests per minute.
MAX_MINUTES=25
RATE_LIMIT=60
